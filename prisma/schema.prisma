generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BoardProvider {
  GREENHOUSE
  LEVER
}

enum ApplicationStatus {
  DRAFT
  APPROVED
  HANDED_OFF
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  profile      Profile?
  jobBoards    JobBoard[]
  applications Application[]
}

model Profile {
  id         String   @id @default(cuid())
  ownerId    String?  @unique
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String   @default("")
  email      String   @default("")
  phone      String   @default("")
  location   String   @default("")
  headline   String   @default("")
  summary    String   @default("")
  skills     String[] @default([])
  experience Json
  education  Json
  updatedAt  DateTime @updatedAt
}

model JobBoard {
  id          String       @id @default(cuid())
  ownerId     String?
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider    BoardProvider
  companyName String
  slug        String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@unique([ownerId, provider, slug])
  @@index([ownerId, active])
}

model Application {
  id               String            @id @default(cuid())
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider         BoardProvider
  externalId       String
  companyName      String
  title            String
  location         String
  description      String
  applyUrl         String
  tailoredCv       Json?
  coverLetter      String            @default("")
  status           ApplicationStatus @default(DRAFT)
  approvedAt       DateTime?
  handedOffAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([ownerId, status, updatedAt])
}
